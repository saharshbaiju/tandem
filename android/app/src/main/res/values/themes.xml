<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Material 3 with wallpaper-based dynamic color on Android 12+ (Material
         You), like Google's own apps. Light/dark follows the system. -->
    <style name="Theme.Tandem" parent="Theme.Material3.DynamicColors.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Applied in code only when dynamic color is unavailable (Android < 12). -->
    <style name="ThemeOverlay.Tandem.Fallback" parent="">
        <item name="colorPrimary">@color/fb_primary</item>
        <item name="colorOnPrimary">@color/fb_on_primary</item>
        <item name="colorPrimaryContainer">@color/fb_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/fb_on_primary_container</item>
        <item name="colorSecondaryContainer">@color/fb_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/fb_on_secondary_container</item>
        <item name="colorSurface">@color/fb_surface</item>
        <item name="colorOnSurface">@color/fb_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/fb_on_surface_variant</item>
        <item name="colorSurfaceContainerLow">@color/fb_surface_low</item>
        <item name="colorSurfaceContainer">@color/fb_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/fb_surface_high</item>
        <item name="colorSurfaceContainerHighest">@color/fb_surface_highest</item>
        <item name="colorOutline">@color/fb_outline</item>
    </style>

    <!-- A label/value tile in the live control sheet. -->
    <style name="StatLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="StatValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:text">—</item>
    </style>

    <style name="StatTile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>
</resources>
