<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- OLED black, the website's palette: pure black surfaces, near-white
         ink, greys for everything secondary. Always dark (no wallpaper colours,
         no light mode), so blacks are true blacks and the pixels are off. -->
    <style name="Theme.Tandem" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:colorBackground">@color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- The white button on black, like the website's solid buttons. -->
        <item name="colorPrimary">@color/ink</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorPrimaryContainer">@color/surface_4</item>
        <item name="colorOnPrimaryContainer">@color/ink</item>
        <item name="colorSecondary">@color/ink_dim</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSecondaryContainer">@color/surface_4</item>
        <item name="colorOnSecondaryContainer">@color/ink</item>
        <item name="colorTertiary">@color/ink</item>
        <item name="colorOnTertiary">@color/black</item>

        <item name="colorSurface">@color/black</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceVariant">@color/surface_3</item>
        <item name="colorOnSurfaceVariant">@color/gray_1</item>
        <item name="colorSurfaceDim">@color/black</item>
        <item name="colorSurfaceBright">@color/surface_4</item>
        <item name="colorSurfaceContainerLowest">@color/black</item>
        <item name="colorSurfaceContainerLow">@color/surface_1</item>
        <item name="colorSurfaceContainer">@color/surface_2</item>
        <item name="colorSurfaceContainerHigh">@color/surface_2</item>
        <item name="colorSurfaceContainerHighest">@color/surface_3</item>
        <item name="colorSurfaceInverse">@color/ink</item>
        <item name="colorOnSurfaceInverse">@color/black</item>

        <item name="colorOutline">@color/gray_2</item>
        <item name="colorOutlineVariant">@color/gray_3</item>
        <item name="colorError">@color/red</item>
        <item name="colorOnError">@color/ink</item>
    </style>

    <!-- A label/value tile in the live control sheet. -->
    <style name="StatLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="StatValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:text">—</item>
    </style>

    <style name="StatTile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <!-- A key on the key bar shown above the phone's keyboard. -->
    <style name="KeyBarKey" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <!-- Touch / Pointer: the two halves of the side sheet's mode switch. -->
    <style name="InputModeButton" parent="Widget.Material3.Button.OutlinedButton.Icon">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">24dp</item>
    </style>

    <!-- The round icon buttons in the side sheet's control row. -->
    <style name="SheetIconToggle" parent="Widget.Material3.Button.IconButton.Filled.Tonal">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">52dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="iconSize">24dp</item>
    </style>
</resources>
