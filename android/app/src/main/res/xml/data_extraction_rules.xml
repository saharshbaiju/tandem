<?xml version="1.0" encoding="utf-8"?>
<!-- The saved computer includes its pairing key: keep it out of cloud backups
     and phone-to-phone transfers (a new phone pairs by scanning the QR). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
