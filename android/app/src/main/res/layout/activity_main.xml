<?xml version="1.0" encoding="utf-8"?>
<!--
  Layers, back to front:
    surface        the decoded desktop (letterboxed SurfaceView)
    connectScreen  Material 3 connect UI; dissolves like water into the video
    statusPill / edgeHandle   "Connecting…" / "Reconnecting…" pill, and the
                              edge handle to the side sheet
    scrim + controlSheet      side sheet with stream details, controls
                              (keyboard) and Disconnect
    keyboardTarget + keyBar   what the phone's keyboard types into, and the
                              Esc / Tab / Ctrl / Alt / Super / arrow keys
                              shown above it while typing
    splash         ASCII "Tandem" on black; ripples open onto the connect
                   screen at launch, then it is gone
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <io.github.saharshbaiju.tandem.AspectRatioSurfaceView
        android:id="@+id/surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- ============================================================ connect -->
    <io.github.saharshbaiju.tandem.RippleRevealLayout
        android:id="@+id/connectScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface">

        <LinearLayout
            android:id="@+id/connectContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="40dp"
            android:paddingTop="20dp"
            android:paddingEnd="28dp"
            android:paddingBottom="20dp">

            <!-- left: identity -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="36dp">

                <!-- "Tandem" in ASCII, like the splash and the website. -->
                <io.github.saharshbaiju.tandem.AsciiWordmarkView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:contentDescription="@string/app_name" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/tagline"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <!-- Attribution required by the GPL section 7 terms in NOTICE. -->
                <TextView
                    android:id="@+id/credit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="@string/credit"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <!-- "A newer Tandem is out" (UpdateCheck): shown only when the
                     latest release on GitHub is newer than this app. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/updateCard"
                    style="?attr/materialCardViewFilledStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                    app:cardCornerRadius="20dp">

                    <!-- Text on top, the two buttons under it on the right: a
                         side-by-side row squeezes the buttons on a phone. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="16dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:id="@+id/updateTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/update_title"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/updateBody"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="end"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/updateLaterBtn"
                                style="?attr/borderlessButtonStyle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/update_later" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/updateBtn"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="@string/update_action" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- right: the connect card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/connectCard"
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.15"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                app:cardCornerRadius="28dp">

                <!-- Scrolls only when it doesn't fit: manual entry on a short
                     landscape phone is taller than the screen. -->
                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fillViewport="true"
                    android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/cardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/card_title_new"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/cardBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/card_body_new"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <!-- the computer we'll connect to -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/targetRow"
                        style="?attr/materialCardViewFilledStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:visibility="gone"
                        app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
                        app:cardCornerRadius="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="14dp">

                            <com.google.android.material.card.MaterialCardView
                                style="?attr/materialCardViewFilledStyle"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                app:cardBackgroundColor="?attr/colorSecondaryContainer"
                                app:cardCornerRadius="20dp">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_desktop"
                                    app:tint="?attr/colorOnSecondaryContainer" />
                            </com.google.android.material.card.MaterialCardView>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/targetName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="?attr/textAppearanceTitleMedium"
                                    android:textColor="?attr/colorOnSurface" />

                                <TextView
                                    android:id="@+id/targetAddr"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="?attr/textAppearanceBodySmall"
                                    android:textColor="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/editBtn"
                                style="?attr/materialIconButtonStyle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/enter_manually"
                                app:icon="@drawable/ic_edit" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- manual entry: address, port and the pairing code shown in tandem -->
                    <LinearLayout
                        android:id="@+id/manualGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.textfield.TextInputLayout
                                style="?attr/textInputOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="@string/address">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/hostInput"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:imeOptions="actionNext|flagNoExtractUi"
                                    android:inputType="textUri"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                style="?attr/textInputOutlinedStyle"
                                android:layout_width="104dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:hint="@string/port">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/portInput"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:imeOptions="actionNext|flagNoExtractUi"
                                    android:inputType="number"
                                    android:maxLines="1"
                                    android:text="5000" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="?attr/textInputOutlinedStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:hint="@string/pairing_code"
                            app:helperText="@string/pairing_code_help">

                            <!-- visible password: no autocorrect, no suggestions,
                                 not learned by the keyboard -->
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/codeInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:imeOptions="actionGo|flagNoExtractUi|flagNoPersonalizedLearning"
                                android:importantForAutofill="no"
                                android:inputType="textVisiblePassword|textNoSuggestions"
                                android:maxLength="32"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/errorText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorError"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/primaryBtn"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="20dp"
                        android:text="@string/scan_qr"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        app:cornerRadius="28dp"
                        app:icon="@drawable/ic_qr_scan"
                        app:iconGravity="textStart"
                        app:iconPadding="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/scanBtn"
                            style="@style/Widget.Material3.Button.TextButton.Icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/scan_again"
                            android:visibility="gone"
                            app:icon="@drawable/ic_qr_scan" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/manualBtn"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/enter_manually" />
                    </LinearLayout>
                </LinearLayout>
                </androidx.core.widget.NestedScrollView>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </io.github.saharshbaiju.tandem.RippleRevealLayout>

    <!-- ========================================================= live chrome -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/statusPill"
        style="?attr/materialCardViewFilledStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="14dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/pill_bg"
        app:cardCornerRadius="20dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <View
                android:id="@+id/dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/live_dot" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="@color/pill_text" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- slim grab handle on the right edge; big invisible touch target -->
    <FrameLayout
        android:id="@+id/edgeHandle"
        android:layout_width="32dp"
        android:layout_height="140dp"
        android:layout_gravity="end|center_vertical"
        android:contentDescription="@string/sheet_overline"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewFilledStyle"
            android:layout_width="5dp"
            android:layout_height="56dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="6dp"
            app:cardBackgroundColor="#CCFFFFFF"
            app:cardCornerRadius="3dp" />
    </FrameLayout>

    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:visibility="gone" />

    <!-- ========================================================= side sheet -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/controlSheet"
        style="?attr/materialCardViewElevatedStyle"
        android:layout_width="340dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_margin="12dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
        app:cardCornerRadius="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="24dp">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sheet_overline"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/sheetTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/sheetSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="6dp" />

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2">

                        <LinearLayout style="@style/StatTile">
                            <TextView style="@style/StatLabel" android:text="@string/stat_resolution" />
                            <TextView android:id="@+id/sheetRes" style="@style/StatValue" />
                        </LinearLayout>

                        <LinearLayout style="@style/StatTile">
                            <TextView style="@style/StatLabel" android:text="@string/stat_refresh" />
                            <TextView android:id="@+id/sheetFps" style="@style/StatValue" />
                        </LinearLayout>

                        <LinearLayout style="@style/StatTile">
                            <TextView style="@style/StatLabel" android:text="@string/stat_scale" />
                            <TextView android:id="@+id/sheetScale" style="@style/StatValue" />
                        </LinearLayout>

                        <LinearLayout style="@style/StatTile">
                            <TextView style="@style/StatLabel" android:text="@string/stat_position" />
                            <TextView android:id="@+id/sheetSide" style="@style/StatValue" />
                        </LinearLayout>

                        <LinearLayout style="@style/StatTile">
                            <TextView style="@style/StatLabel" android:text="@string/stat_quality" />
                            <TextView android:id="@+id/sheetQuality" style="@style/StatValue" />
                        </LinearLayout>

                        <LinearLayout style="@style/StatTile">
                            <TextView style="@style/StatLabel" android:text="@string/stat_desktop" />
                            <TextView android:id="@+id/sheetBackend" style="@style/StatValue" />
                        </LinearLayout>

                        <!-- full width: the "why not" note can be a sentence -->
                        <LinearLayout
                            style="@style/StatTile"
                            android:layout_columnSpan="2">
                            <TextView style="@style/StatLabel" android:text="@string/stat_touch" />
                            <TextView android:id="@+id/sheetTouch" style="@style/StatValue" />
                            <TextView
                                android:id="@+id/sheetTouchNote"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:visibility="gone" />
                        </LinearLayout>
                    </GridLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- controls: touch or pointer mode, portrait, keyboard -->
            <LinearLayout
                android:id="@+id/sheetControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/inputModeGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:checkedButton="@id/touchModeBtn"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/touchModeBtn"
                        style="@style/InputModeButton"
                        android:contentDescription="@string/mode_touch"
                        app:icon="@drawable/ic_touch" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pointerModeBtn"
                        style="@style/InputModeButton"
                        android:contentDescription="@string/mode_pointer"
                        app:icon="@drawable/ic_pointer" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rotateBtn"
                    style="@style/SheetIconToggle"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/rotate_to_portrait"
                    app:icon="@drawable/ic_rotate" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyboardBtn"
                    style="@style/SheetIconToggle"
                    android:contentDescription="@string/keyboard_open"
                    app:icon="@drawable/ic_keyboard" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/disconnectBtn"
                style="@style/Widget.Material3.Button.TonalButton.Icon"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="@string/disconnect"
                app:cornerRadius="26dp"
                app:icon="@drawable/ic_power" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ========================================================== rotation -->
    <!-- "Turn the monitor too?" after the phone is turned; goes away by
         itself. rotatePromptFrame is sized and turned to match the way the
         phone is held (MainActivity.showRotatePrompt), so the card inside
         lays out upright in that frame, never as a turned-around view
         drawn outside its own bounds. Touches outside the card pass
         through to the picture. -->
    <FrameLayout
        android:id="@+id/rotatePromptFrame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/rotatePrompt"
        style="?attr/materialCardViewElevatedStyle"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_rotate"
                    app:tint="@color/ink" />

                <TextView
                    android:id="@+id/rotatePromptText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="@string/rotate_prompt_portrait"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="@color/ink" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/rotatePromptTimer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:max="1000"
                    app:trackCornerRadius="2dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rotatePromptBtn"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rotate_yes" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <!-- ========================================================== keyboard -->
    <!-- What the phone's keyboard types into (invisible; it holds no text). -->
    <io.github.saharshbaiju.tandem.KeyboardTargetView
        android:id="@+id/keyboardTarget"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:alpha="0" />

    <!-- Keys a phone keyboard lacks, at the bottom while typing: just above a
         docked keyboard, at the screen's edge under a floating one. -->
    <LinearLayout
        android:id="@+id/keyBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/key_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="4dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyEsc" style="@style/KeyBarKey" android:text="@string/key_esc" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyTab" style="@style/KeyBarKey" android:text="@string/key_tab" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyCtrl" style="@style/KeyBarKey" android:text="@string/key_ctrl" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyAlt" style="@style/KeyBarKey" android:text="@string/key_alt" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keySuper" style="@style/KeyBarKey" android:text="@string/key_super" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyDel" style="@style/KeyBarKey" android:text="@string/key_del" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyLeft" style="@style/KeyBarKey" android:text="←"
                    android:contentDescription="@string/key_left" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyUp" style="@style/KeyBarKey" android:text="↑"
                    android:contentDescription="@string/key_up" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyDown" style="@style/KeyBarKey" android:text="↓"
                    android:contentDescription="@string/key_down" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyRight" style="@style/KeyBarKey" android:text="→"
                    android:contentDescription="@string/key_right" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- minimise: hide the phone's keyboard, keep these keys (and back) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/keyboardToggleBtn"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/keyboard_hide"
            app:icon="@drawable/ic_keyboard_hide" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/keyboardCloseBtn"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/keyboard_close"
            app:icon="@drawable/ic_close" />
    </LinearLayout>

    <!-- ============================================================ splash -->
    <io.github.saharshbaiju.tandem.AsciiSplashView
        android:id="@+id/splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
