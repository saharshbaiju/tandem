<?xml version="1.0" encoding="utf-8"?>
<!--
  Layers, back to front:
    surface        the decoded desktop (letterboxed SurfaceView)
    connectScreen  Material 3 connect UI; dissolves like water into the video
    statusPill / edgeHandle   "Connecting…" / "Reconnecting…" pill, and the
                              edge handle to the side sheet
    scrim + controlSheet      side sheet with stream details + Disconnect
    splash         ASCII "Tandem" on black; ripples open onto the connect
                   screen at launch, then it is gone
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <io.github.saharshbaiju.tandem.AspectRatioSurfaceView
        android:id="@+id/surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- ============================================================ connect -->
    <io.github.saharshbaiju.tandem.RippleRevealLayout
        android:id="@+id/connectScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface">

        <LinearLayout
            android:id="@+id/connectContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="40dp"
            android:paddingTop="20dp"
            android:paddingEnd="28dp"
            android:paddingBottom="20dp">

            <!-- left: identity -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="36dp">

                <!-- The app's logo: the launcher icon's ASCII "T" on black. -->
                <com.google.android.material.card.MaterialCardView
                    style="?attr/materialCardViewFilledStyle"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    app:cardBackgroundColor="@color/brand"
                    app:cardCornerRadius="18dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_launcher_foreground" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/app_name"
                    android:textAppearance="?attr/textAppearanceDisplaySmall"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/tagline"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/statusChip"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:clickable="false"
                    android:text="@string/status_idle"
                    app:chipIcon="@drawable/ic_link"
                    app:chipIconTint="?attr/colorOnSurfaceVariant" />

                <!-- Attribution required by the GPL section 7 terms in NOTICE. -->
                <TextView
                    android:id="@+id/credit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/credit"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <!-- right: the connect card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/connectCard"
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.15"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                app:cardCornerRadius="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/cardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/card_title_new"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/cardBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/card_body_new"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <!-- the computer we'll connect to -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/targetRow"
                        style="?attr/materialCardViewFilledStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:visibility="gone"
                        app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
                        app:cardCornerRadius="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="14dp">

                            <com.google.android.material.card.MaterialCardView
                                style="?attr/materialCardViewFilledStyle"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                app:cardBackgroundColor="?attr/colorSecondaryContainer"
                                app:cardCornerRadius="20dp">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_desktop"
                                    app:tint="?attr/colorOnSecondaryContainer" />
                            </com.google.android.material.card.MaterialCardView>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/targetName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="?attr/textAppearanceTitleMedium"
                                    android:textColor="?attr/colorOnSurface" />

                                <TextView
                                    android:id="@+id/targetAddr"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="?attr/textAppearanceBodySmall"
                                    android:textColor="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/editBtn"
                                style="?attr/materialIconButtonStyle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/enter_manually"
                                app:icon="@drawable/ic_edit" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- manual entry: address, port and the pairing code shown in tandem -->
                    <LinearLayout
                        android:id="@+id/manualGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.textfield.TextInputLayout
                                style="?attr/textInputOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="@string/address">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/hostInput"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:imeOptions="actionNext|flagNoExtractUi"
                                    android:inputType="textUri"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                style="?attr/textInputOutlinedStyle"
                                android:layout_width="104dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:hint="@string/port">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/portInput"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:imeOptions="actionNext|flagNoExtractUi"
                                    android:inputType="number"
                                    android:maxLines="1"
                                    android:text="5000" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="?attr/textInputOutlinedStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:hint="@string/pairing_code"
                            app:helperText="@string/pairing_code_help">

                            <!-- visible password: no autocorrect, no suggestions,
                                 not learned by the keyboard -->
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/codeInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:imeOptions="actionGo|flagNoExtractUi|flagNoPersonalizedLearning"
                                android:importantForAutofill="no"
                                android:inputType="textVisiblePassword|textNoSuggestions"
                                android:maxLength="32"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/errorText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorError"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/primaryBtn"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="20dp"
                        android:text="@string/scan_qr"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        app:cornerRadius="28dp"
                        app:icon="@drawable/ic_qr_scan"
                        app:iconGravity="textStart"
                        app:iconPadding="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/scanBtn"
                            style="@style/Widget.Material3.Button.TextButton.Icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/scan_again"
                            android:visibility="gone"
                            app:icon="@drawable/ic_qr_scan" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/manualBtn"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/enter_manually" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </io.github.saharshbaiju.tandem.RippleRevealLayout>

    <!-- ========================================================= live chrome -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/statusPill"
        style="?attr/materialCardViewFilledStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="14dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/pill_bg"
        app:cardCornerRadius="20dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <View
                android:id="@+id/dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/live_dot" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="@color/pill_text" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- slim grab handle on the right edge; big invisible touch target -->
    <FrameLayout
        android:id="@+id/edgeHandle"
        android:layout_width="32dp"
        android:layout_height="140dp"
        android:layout_gravity="end|center_vertical"
        android:contentDescription="@string/sheet_overline"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewFilledStyle"
            android:layout_width="5dp"
            android:layout_height="56dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="6dp"
            app:cardBackgroundColor="#CCFFFFFF"
            app:cardCornerRadius="3dp" />
    </FrameLayout>

    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:visibility="gone" />

    <!-- ========================================================= side sheet -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/controlSheet"
        style="?attr/materialCardViewElevatedStyle"
        android:layout_width="340dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_margin="12dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
        app:cardCornerRadius="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="24dp">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sheet_overline"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/sheetTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/sheetSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="6dp" />

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2">

                        <LinearLayout style="@style/StatTile">
                            <TextView style="@style/StatLabel" android:text="@string/stat_resolution" />
                            <TextView android:id="@+id/sheetRes" style="@style/StatValue" />
                        </LinearLayout>

                        <LinearLayout style="@style/StatTile">
                            <TextView style="@style/StatLabel" android:text="@string/stat_refresh" />
                            <TextView android:id="@+id/sheetFps" style="@style/StatValue" />
                        </LinearLayout>

                        <LinearLayout style="@style/StatTile">
                            <TextView style="@style/StatLabel" android:text="@string/stat_scale" />
                            <TextView android:id="@+id/sheetScale" style="@style/StatValue" />
                        </LinearLayout>

                        <LinearLayout style="@style/StatTile">
                            <TextView style="@style/StatLabel" android:text="@string/stat_position" />
                            <TextView android:id="@+id/sheetSide" style="@style/StatValue" />
                        </LinearLayout>

                        <LinearLayout style="@style/StatTile">
                            <TextView style="@style/StatLabel" android:text="@string/stat_quality" />
                            <TextView android:id="@+id/sheetQuality" style="@style/StatValue" />
                        </LinearLayout>

                        <LinearLayout style="@style/StatTile">
                            <TextView style="@style/StatLabel" android:text="@string/stat_desktop" />
                            <TextView android:id="@+id/sheetBackend" style="@style/StatValue" />
                        </LinearLayout>

                        <!-- full width: the "why not" note can be a sentence -->
                        <LinearLayout
                            style="@style/StatTile"
                            android:layout_columnSpan="2">
                            <TextView style="@style/StatLabel" android:text="@string/stat_touch" />
                            <TextView android:id="@+id/sheetTouch" style="@style/StatValue" />
                            <TextView
                                android:id="@+id/sheetTouchNote"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:visibility="gone" />
                        </LinearLayout>
                    </GridLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/disconnectBtn"
                style="@style/Widget.Material3.Button.TonalButton.Icon"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="@string/disconnect"
                app:cornerRadius="26dp"
                app:icon="@drawable/ic_power" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ============================================================ splash -->
    <io.github.saharshbaiju.tandem.AsciiSplashView
        android:id="@+id/splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
